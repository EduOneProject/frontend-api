{
  "name": "@eduone/graphql-codegen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "从后端 GraphQL SDL 生成 TypeScript axios 客户端",
  "bin": {
    "graphql-codegen": "./src/index.mjs"
